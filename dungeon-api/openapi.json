    "/leaderboard": {
      "get": {
        "tags": [
          "Classement"
        ],
        "summary": "Leaderboard",
        "operationId": "leaderboard_leaderboard_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HeroRead"
                  },
                  "type": "array",
                  "title": "Response Leaderboard Leaderboard Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Système"
        ],
        "summary": "Health",
        "description": "Vérifie que le serveur répond.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttackResult": {
        "properties": {
          "degats_infliges": {
            "type": "integer",
            "title": "Degats Infliges"
          },
          "critique": {
            "type": "boolean",
            "title": "Critique"
          },
          "degats_subis": {
            "type": "integer",
            "title": "Degats Subis"
          },
          "pv_heros": {
            "type": "integer",
            "title": "Pv Heros"
          },
          "pv_monstre": {
            "type": "integer",
            "title": "Pv Monstre"
          },
          "issue": {
            "type": "string",
            "enum": [
              "en_cours",
              "monstre_vaincu",
              "heros_mort"
            ],
            "title": "Issue"
          },
          "or_gagne": {
            "type": "integer",
            "title": "Or Gagne"
          },
          "victoire": {
            "type": "boolean",
            "title": "Victoire"
          }
        },
        "type": "object",
        "required": [
          "degats_infliges",
          "critique",
          "degats_subis",
          "pv_heros",
          "pv_monstre",
          "issue",
          "or_gagne",
          "victoire"
        ],
        "title": "AttackResult"
      },
      "Body_login_auth_login_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Body_login_auth_login_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HeroCreate": {
        "properties": {
          "nom": {
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "title": "Nom"
          },
          "classe": {
            "type": "string",
            "enum": [
              "guerrier",
              "mage",
              "voleur"
            ],
            "title": "Classe"
          },
          "force": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Force"
          },
          "agilite": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Agilite"
          },
          "intelligence": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Intelligence"
          }
        },
        "type": "object",
        "required": [
          "nom",
          "classe",
          "force",
          "agilite",
          "intelligence"
        ],
        "title": "HeroCreate",
        "description": "Body de POST /heroes. Toute donnée invalide renvoie automatiquement une 422."
      },
      "HeroRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nom": {
            "type": "string",
            "title": "Nom"
          },
          "classe": {
            "type": "string",
            "title": "Classe"
          },
          "force": {
            "type": "integer",
            "title": "Force"
          },
          "agilite": {
            "type": "integer",
            "title": "Agilite"
          },
          "intelligence": {
            "type": "integer",
            "title": "Intelligence"
          },
          "pv": {
            "type": "integer",
            "title": "Pv"
          },
          "pv_max": {
            "type": "integer",
            "title": "Pv Max"
          },
          "salle_actuelle": {
            "type": "string",
            "title": "Salle Actuelle"
          },
          "or_": {
            "type": "integer",
            "title": "Or"
          },
          "victoire": {
            "type": "boolean",
            "title": "Victoire"
          },
          "en_combat": {
            "type": "boolean",
            "title": "En Combat"
          },
          "est_vivant": {
            "type": "boolean",
            "title": "Est Vivant"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nom",
          "classe",
          "force",
          "agilite",
          "intelligence",
          "pv",
          "pv_max",
          "salle_actuelle",
          "or_",
          "victoire",
          "en_combat",
          "est_vivant"
        ],
        "title": "HeroRead",
        "description": "Réponse renvoyée par l'API : monstre_pv est remplacé par en_combat et est_vivant."
      },
      "MonsterRead": {
        "properties": {
          "nom": {
            "type": "string",
            "title": "Nom"
          },
          "pv": {
            "type": "integer",
            "title": "Pv"
          },
          "pv_max": {
            "type": "integer",
            "title": "Pv Max"
          },
          "attaque": {
            "type": "integer",
            "title": "Attaque"
          }
        },
        "type": "object",
        "required": [
          "nom",
          "pv",
          "pv_max",
          "attaque"
        ],
        "title": "MonsterRead",
        "description": "Monstre affronté par le héros (présent uniquement si un combat est en cours)."
      },
      "MoveRequest": {
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "nord",
              "sud",
              "est",
              "ouest"
            ],
            "title": "Direction"
          }
        },
        "type": "object",
        "required": [
          "direction"
        ],
        "title": "MoveRequest",
        "description": "Body de POST /heroes/{id}/move. Une direction inconnue renvoie automatiquement une 422."
      },
      "PlayerCreate": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 30,
            "minLength": 3,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "minLength": 4,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "PlayerCreate"
      },
      "PlayerRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "title": "PlayerRead"
      },
      "RoomRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "nom": {
            "type": "string",
            "title": "Nom"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "sorties": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sorties"
          },
          "monstre": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MonsterRead"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "nom",
          "description",
          "sorties",
          "monstre"
        ],
        "title": "RoomRead",
        "description": "Réponse de GET /heroes/{id}/room et de POST /heroes/{id}/move."
      },
      "Token": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "Token"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "type": "oauth2",
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/auth/login"
          }
        }
      }
    }
  }
}